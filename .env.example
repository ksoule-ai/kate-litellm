# Copy to .env with `make init` (which also generates the three secrets below).
# .env is gitignored. Never commit real values.

# --- Gateway secrets (generated by `make init`) ---
# Admin key for the API and UI. Must start with "sk-".
LITELLM_MASTER_KEY=
# Encrypts provider credentials stored in the database. Do not change it after
# first boot, or stored credentials become unreadable.
LITELLM_SALT_KEY=
POSTGRES_PASSWORD=

# --- Admin UI login (http://localhost:4000/ui) ---
UI_USERNAME=admin
UI_PASSWORD=

# --- Optional overrides ---
# Pin to a specific release once this is in daily use.
# LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
# LITELLM_PORT=4000
# Port of the prompt renderer the log viewer calls.
# PROMPT_PORT=4001
# Port of `kl serve`, which the Agent Sessions tab in the UI shows.
# KL_PORT=4002

# --- kl (see README, "Agent sessions") ---
# Ollama model that kl's manager agent and handoff summaries run on, as
# ollama_chat/<name from `ollama list`>. It must support tools.
KL_LOCAL_MODEL=ollama_chat/granite4.1:8b

# --- Provider keys: fill in the ones you use, leave the rest blank ---
OPENROUTER_API_KEY=
REPLICATE_API_KEY=
# Hugging Face access token; used for both serverless Inference Providers and
# dedicated Inference Endpoints.
HF_TOKEN=
