# Most transcript text sent to the summariser in one request. Longer transcripts
# are summarised piece by piece, so a small local model can do the job.
CHUNK_CHARS = int(os.environ.get("KL_SUMMARY_CHUNK_CHARS", "24000"))
# How to query the gateway's Postgres. Override to reach a database elsewhere.
PSQL = os.environ.get("KL_PSQL", "docker compose exec -T db psql -U litellm litellm")
HANDOFF = ".kl/HANDOFF.md"
SEED = (f"Read {HANDOFF}. It describes the earlier session this one continues from. "
        "Tell me briefly what state the work is in, then wait for my instructions.")

