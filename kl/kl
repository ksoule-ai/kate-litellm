    "pi": {"cmd": ["pi"], "env": ["kl"], "seed": "arg"},
    # Reads the endpoint and key from its config.yaml ("${KL_API_KEY}"); see `kl setup hermes`.
    "hermes": {"cmd": ["hermes", "chat"], "env": ["kl"], "seed": "keys"},
}

